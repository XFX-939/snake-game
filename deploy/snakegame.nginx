server {
    listen 80;
    listen [::]:80;
    server_name snakegame.xiangfuxing.tech;

    root /var/www/snake-game/current;
    index index.html;

    access_log /var/log/nginx/snake-game.access.log;
    error_log /var/log/nginx/snake-game.error.log;

    location / {
        try_files $uri $uri/ /index.html;
    }

    location /assets/ {
        try_files $uri =404;
        expires 30d;
        add_header Cache-Control "public, immutable";
    }
}
